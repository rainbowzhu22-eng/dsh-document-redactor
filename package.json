{
  "name": "dsh-document-redactor",
  "version": "1.3.1",
  "description": "Local document redaction and review with DSH Agent rule assistance",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./001-contract-desensitizer/04-dsh-plugin/index.js",
  "exports": {
    ".": "./001-contract-desensitizer/04-dsh-plugin/index.js",
    "./client": "./001-contract-desensitizer/04-dsh-plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "001-contract-desensitizer/04-dsh-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "redaction",
    "offline"
  ],
  "dsh": {
    "bundle": {
      "patch": "./001-contract-desensitizer/04-dsh-plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rainbowzhu22-eng/cece_legal_skills.git"
  },
  "homepage": "https://xingchendata.com/dsh-document-redactor.html"
}
